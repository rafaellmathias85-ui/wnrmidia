{
  "name": "wnrmidia-display-client",
  "version": "1.0.0",
  "description": "WNR Mídia — Cliente de Display Digital",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "br.com.wnrtecnologia.wnrmidia.display",
    "productName": "WNR Midia Display",
    "artifactName": "WNRMidiaDisplay-Setup.exe",
    "copyright": "Copyright © 2025 WNR Tecnologia",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WNR Midia Display",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
