{
  "name": "wnrmidia-display-client",
  "version": "1.0.1",
  "description": "WNR Mídia — Cliente de Display Digital",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "br.com.wnrtecnologia.wnrmidia.display",
    "productName": "WNR Midia Display",
    "artifactName": "WNRMidiaDisplay-Setup.zip",
    "copyright": "Copyright © 2025 WNR Tecnologia",
    "publish": null,
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }]
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
