# .gitignore

# Dependencies
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# Environment
.env
.env.local
.env.*.local

# Build
dist/
build/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-workspace
*.sublime-project

# OS
.DS_Store
Thumbs.db

# Database
*.sqlite
*.sqlite3
*.db

# Uploads (user-generated content)
uploads/
!uploads/.gitkeep

# Logs
logs/
*.log

# Misc
.cache/
tmp/
